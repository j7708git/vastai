{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VastUploadGeneratedAssets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::vast-comfyui-730116069170-ap-southeast-2-an/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "VastReadAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::vast-comfyui-730116069170-ap-southeast-2-an/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
